{
  "name": "civicpulse-desktop",
  "private": true,
  "version": "0.10.0",
  "description": "Connected Dhaka civic complaint desktop and web app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "desktop": "electron .",
    "web": "npm run build && node server/web.cjs",
    "web:open": "npm run build && node server/web.cjs --open",
    "cloud:dev": "npm run build && wrangler dev --local",
    "cloud:deploy": "npm run build && wrangler deploy",
    "package:win": "npm run build && node electron/package-win.cjs",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "test": "node --test electron/database.test.cjs server/web.test.cjs cloudflare/worker.test.mjs",
    "smoke": "node electron/ui-smoke.cjs",
    "smoke:cloud": "node electron/cloud-smoke.cjs",
    "smoke:mobile": "node scripts/mobile-smoke.cjs",
    "smoke:a11y": "node scripts/accessibility-smoke.cjs",
    "smoke:package": "node electron/packaged-smoke.cjs"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1",
    "wrangler": "^4.141.0"
  },
  "build": {
    "appId": "org.civicpulse.desktop",
    "productName": "CivicPulse",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.svg"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.svg"
    }
  }
}
